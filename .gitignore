# IDEs
.vscode/
.idea/

# Datos reales de prueba (PII de estudiantes) - nunca deben subirse al repo
docs/muestras/

# Scripts de debugging/auditoria efimeros (raiz del repo). Si necesitas
# uno persistente, moverlo a scripts/ y darle nombre descriptivo.
check_*.py
/test_*.py
cleanup_*.py
create_ui_*.py
get_token.py
dnstest.py
resize_icons.py
_idxcheck_tmp.py

# F-CERTIFICADOS (2026-07-29): PDFs generados por tests funcionales
# standalone (manual_test_pdf.py). No son artefactos de pytest, son outputs
# de una corrida manual para inspección visual. Se borran o se regeneran.
tests/_pdf_test_*.pdf
_set_test_password.py

# Scripts de debugging/auditoria efimeros (raiz y subdirs).
# Patrones: _audit_*, _test_*, _list_*, _set_*, _commit_msg.txt
# Si necesitas uno persistente, moverlo a scripts/ con nombre descriptivo.
_audit_*.py
_audit_*.mjs
_test_*.py
_test_*.mjs
_list_*.py
_set_*.py
_commit_msg.txt
.gitignore.append
